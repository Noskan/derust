#!/usr/sbin/nft -f
# Firewall da VPS do derust (docs/OPS.md, portão do passo 3 em docs/FASE_2_5.md).
#
# Entra só: o jogo (8281), o HTTP/HTTPS do Caddy (80/443, o painel de GM e o certificado) e o SSH
# (22, só com chave: deploy/ssh/derust.conf). Todo o resto fica local: DBSrv (7514), porta de
# admin do DBSrv (8895), Postgres, o socket do w2db, Prometheus (9090), Alertmanager (9093),
# node_exporter (9100), /metrics do w2db (9730), Grafana (3000) e o w2gm (8730). Os serviços já
# ouvem em 127.0.0.1 ou em Unix socket; esta tabela é a segunda trava.
#
# Instale em /etc/nftables.conf (ou inclua de lá) e: sudo systemctl enable --now nftables
# Confira antes de aplicar: sudo nft -c -f deploy/nftables/derust.nft

table inet derust
delete table inet derust

table inet derust {
	# Conexões novas no jogo por IP: o TMSrv também limita (NetGuard), aqui é antes do processo.
	set game4 {
		type ipv4_addr
		flags dynamic, timeout
		timeout 1m
		size 65536
	}
	set game6 {
		type ipv6_addr
		flags dynamic, timeout
		timeout 1m
		size 65536
	}
	# Tentativas de SSH por IP (o sshd só aceita chave, isto corta o barulho).
	set ssh4 {
		type ipv4_addr
		flags dynamic, timeout
		timeout 1m
		size 65536
	}
	set ssh6 {
		type ipv6_addr
		flags dynamic, timeout
		timeout 1m
		size 65536
	}

	chain input {
		type filter hook input priority filter; policy drop;

		iif "lo" accept
		ct state established,related accept
		ct state invalid drop

		# ICMP de controle (path MTU, ping) com limite; o IPv6 precisa do neighbor discovery.
		meta l4proto icmp icmp type { echo-request, destination-unreachable, time-exceeded } limit rate 10/second accept
		meta l4proto ipv6-icmp icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept

		tcp dport 22 ct state new add @ssh4 { ip saddr limit rate over 10/minute burst 10 packets } drop
		tcp dport 22 ct state new add @ssh6 { ip6 saddr limit rate over 10/minute burst 10 packets } drop
		tcp dport 22 accept

		tcp dport { 80, 443 } accept

		tcp dport 8281 ct state new add @game4 { ip saddr limit rate over 5/second burst 20 packets } drop
		tcp dport 8281 ct state new add @game6 { ip6 saddr limit rate over 5/second burst 20 packets } drop
		tcp dport 8281 accept

		counter comment "descartado pela policy"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}
