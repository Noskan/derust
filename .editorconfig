root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false

[*.{cmake,yml,yaml,json,md,py}]
charset = utf-8
indent_style = space
indent_size = 2

[CMakeLists.txt]
charset = utf-8
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{c,cc,cpp,h,hpp}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.rc]
indent_style = space
indent_size = 4
