{
  "db_name": "PostgreSQL",
  "query": "SELECT i.code, i.discord_id, i.created_by, i.created_at, i.used_at, i.revoked_at, a.name AS \"account?\"\n         FROM invites i LEFT JOIN accounts a ON a.id = i.account_id\n         WHERE i.account_id = $1 OR ($2::text IS NOT NULL AND i.discord_id = $2)\n         ORDER BY i.created_at DESC",
